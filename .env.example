# ==========================================
# Paytm Merchant Autopilot - Environment Configuration
# ==========================================

# Server & Application
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paytm_autopilot
REDIS_URL=redis://localhost:6379

# Paytm Merchant Integration
PAYTM_MERCHANT_ID=your_merchant_id_here
PAYTM_MERCHANT_KEY=your_merchant_key_here
PAYTM_ENV=staging
PAYTM_WEBHOOK_SECRET=your_webhook_secret_here

# Messaging & Notifications
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=autopilot@paytm-merchant.example.com

# Phinite Agent Orchestrator
PHINITE_API_KEY=your_phinite_api_key_here
PHINITE_ENVIRONMENT=development

# Financial Reasoning Models (Dianjin / Fin-R1)
MODEL_REASONING_BACKEND=vllm # vllm, ollama, or huggingface
FIN_R1_ENDPOINT=http://localhost:8000/v1
DIANJIN_ENDPOINT=http://localhost:8001/v1
OPENAI_API_KEY=optional_fallback_openai_key

# Security & Session
JWT_SECRET=replace_with_secure_random_jwt_secret
CORS_ORIGIN=http://localhost:3000
